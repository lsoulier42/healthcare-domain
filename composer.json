{
    "name": "lsoulier42/healthcare-domain",
    "description": "Framework-agnostic shared healthcare domain kernel: identifiers, coded concepts, and generic clinical objects for French healthcare applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.11 || ^2.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Healthcare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Healthcare\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs": "phpcs"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
